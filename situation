                question: "돌진 조합이 정면으로 진입할 때, 원딜의 가장 이상적인 포지셔닝과 타겟팅은?",
                options: [
                    {
                        text: "상대 탱커를 무시하고 점멸로 적진 한가운데 들어가 상대 원딜을 먼저 노린다.",
                        isCorrect: false,
                        outcomeType: "dive_fail",
                        rationale: "원딜이 적진에 뛰어들면 상대 브루저들에게 순식간에 포위당해 아무 딜도 못 넣고 폭사합니다."
                    },
                    {
                        text: "아군 서포터의 보호 사거리 내에서 뒤로 카이팅하며 가장 가까이 돌진해 오는 적 앞라인부터 점사한다.",
                        isCorrect: true,
                        outcomeType: "kite_win",
                        rationale: "정답! 돌진 조합 상대로는 진형을 유지하며 뒤로 빠지는 카이팅 구도를 만들고, 들어오는 앞라인부터 녹여야 승리합니다."
                    },
                    {
                        text: "교전이 끝날 때까지 바론 둥지 뒤쪽 벽 너머에 숨어서 아무것도 하지 않는다.",
                        isCorrect: false,
                        outcomeType: "hide_fail",
                        rationale: "핵심 딜러가 딜 공백을 만들면 아군 앞라인이 먼저 무너져 한타를 일방적으로 패배합니다."
                    },
                    {
                        text: "바론 둥지 안으로 들어가 바론을 먼저 치면서 상대가 바론 광역 딜을 맞도록 유도한다.",
                        isCorrect: false,
                        outcomeType: "baron_fail",
                        rationale: "바론의 방어력 감소 디버프와 광역 피해를 동시에 맞아 한타가 즉시 붕괴됩니다."
                    }
                ]
            },
            {
                id: 2,
                category: "은신 대처 & 시야 장악",
                role: "전 포지션 공통",
                desc: "잘 큰 상대 은신 정글러 이블린이 미니맵에서 사라졌습니다. 일반 부쉬 와드만 박혀 있는 상태에서 미드·사이드 라인을 밀려 합니다.",
                question: "은신 암살자 이블린의 연속 암살을 차단하기 위한 가장 효과적인 대처법은?",
                options: [
                    {
                        text: "강가 부쉬에 일반 투명 와드만 2개 겹쳐서 박고 혼자 사이드 라인을 깊게 민다.",
                        isCorrect: false,
                        outcomeType: "ambush_fail",
                        rationale: "일반 투명 와드는 이블린의 위장 상태를 감지하지 못하므로 부쉬 옆을 지나가도 전혀 보이지 않습니다."
                    },
                    {
                        text: "제어 와드를 칼날부리·정글 핵심 통로에 배치해 은신을 감지하고, 1인 단독 푸쉬를 멈춰 아군과 합류한다.",
                        isCorrect: true,
                        outcomeType: "ward_detect",
                        rationale: "정답! 제어 와드 반경 안에서는 위장 상태의 이블린이 드러나므로 핵심 동선에 제어 와드를 박고 아군과 뭉쳐야 암살을 막습니다."
                    },
                    {
                        text: "이블린이 보일 때까지 모든 라인과 정글을 버리고 본진 쌍둥이 포탑 앞에만 서 있는다.",
                        isCorrect: false,
                        outcomeType: "passive_fail",
                        rationale: "모든 오브젝트와 정글을 내주면 골드 격차가 벌어져 자연스럽게 패배합니다."
                    },
                    {
                        text: "서포터 혼자서 어두운 상대 정글 깊숙이 들어가 와드를 지우며 이블린을 찾아다닌다.",
                        isCorrect: false,
                        outcomeType: "support_fail",
                        rationale: "시야 없는 적 정글에 홀로 들어가면 이블린에게 확정 킬을 헌납합니다."
                    }
                ]
            },
            {
                id: 3,
                category: "광역 궁극기 진형 분산",
                role: "전 포지션 공통",
                desc: "드래곤 한타 직전! 아군 5명이 레드 팀 칼날부리 옆 좁은 정글 길목에 뭉쳐서 이동 중이며, 벽 너머 부쉬에 상대 오공이 매복해 있습니다.",
                question: "오공의 광역 에어본(회전격) 대박 각을 방지하기 위한 최선의 팀 움직임은?",
