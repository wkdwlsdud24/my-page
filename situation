                ctx.beginPath(); ctx.moveTo(w * 0.14, h * 0.20); ctx.lineTo(w * 0.84, h * 0.20); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(w * 0.14, h * 0.50); ctx.lineTo(w * 0.84, h * 0.50); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(w * 0.14, h * 0.80); ctx.lineTo(w * 0.84, h * 0.80); ctx.stroke();

                drawTurret(w * 0.82, h * 0.20, '#f43f5e', '탑 2차');
                drawTurret(w * 0.82, h * 0.50, '#f43f5e', '미드 2차');
                drawTurret(w * 0.82, h * 0.80, '#f43f5e', '바텀 2차');
            } else if (mapTheme === 'reset_dragon') {
                // 미드 중앙 & 하단 드래곤 둥지 & 좌측 아군 본진
                drawObjective(w * 0.72, h * 0.74, '드래곤 (30초)', '#f97316');
                ctx.fillStyle = 'rgba(56, 189, 248, 0.12)';
                ctx.fillRect(0, h * 0.55, w * 0.16, h * 0.45);
                ctx.fillStyle = '#38bdf8';
                ctx.font = 'bold 11px "Noto Sans KR"';
                ctx.fillText('아군 우물', 12, h * 0.78);
            }
        }

        function drawWall(x, y, w, h) {
            ctx.fillStyle = '#112233';
            ctx.strokeStyle = '#1e3a52';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.roundRect(x, y, w, h, 10);
            ctx.fill();
            ctx.stroke();
        }

        function drawBush(x, y, r) {
            ctx.fillStyle = 'rgba(16, 185, 129, 0.18)';
            ctx.strokeStyle = 'rgba(16, 185, 129, 0.45)';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
        }

        function drawObjective(x, y, label, color) {
            ctx.fillStyle = color + '33';
            ctx.beginPath();
            ctx.arc(x, y, 22, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(x, y, 11, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#f8fafc';
            ctx.font = 'bold 11px "Noto Sans KR"';
            ctx.textAlign = 'center';
            ctx.fillText(label, x, y + 25);
        }

        function drawTurret(x, y, color, label) {
            ctx.fillStyle = color;
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.rect(x - 9, y - 9, 18, 18);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#cbd5e1';
            ctx.font = '10px "Noto Sans KR"';
            ctx.textAlign = 'center';
            ctx.fillText(label, x, y + 21);
        }

        // 챔피언 유닛 렌더링
        function drawUnit(x, y, label, type, options = {}) {
            const { hp = 1, stealth = false, dead = false, shield = false } = options;
            ctx.save();
            if (stealth) ctx.globalAlpha = 0.35;
            if (dead) ctx.globalAlpha = 0.25;

            let fill = '#38bdf8'; // ally
            let ring = '#0284c7';
            let radius = 13;

            if (type === 'player') {
                fill = '#fbbf24';
                ring = '#ffffff';
                radius = 15;
            } else if (type === 'enemy') {
                fill = '#f43f5e';
                ring = '#9f1239';
            } else if (type === 'minion') {
                fill = '#2dd4bf';
                ring = '#0f766e';
                radius = 7;
            }

            // 그림자/발광
            ctx.beginPath();
            ctx.arc(x, y, radius + 3, 0, Math.PI * 2);
            ctx.fillStyle = type === 'player' ? 'rgba(251, 191, 36, 0.28)' : 'rgba(0,0,0,0.4)';
            ctx.fill();

            // 본체 원
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fillStyle = fill;
            ctx.fill();
            ctx.lineWidth = type === 'player' ? 2.5 : 1.8;
            ctx.strokeStyle = ring;
            ctx.stroke();

            if (shield) {
                ctx.beginPath();
                ctx.arc(x, y, radius + 6, 0, Math.PI * 2);
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 2;
                ctx.setLineDash([4, 3]);
                ctx.stroke();
                ctx.setLineDash([]);
            }

            // 이름 라벨
            if (label) {
                ctx.fillStyle = dead ? '#94a3b8' : '#ffffff';
                ctx.font = type === 'player' ? 'bold 11px "Noto Sans KR"' : '600 10px "Noto Sans KR"';
                ctx.textAlign = 'center';
                ctx.fillText(dead ? `${label}(사망)` : label, x, y - radius - 6);
            }

            // 체력 바
            if (hp < 1 && !dead && type !== 'minion') {
                const bw = 26;
                const bh = 4;
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(x - bw / 2, y + radius + 4, bw, bh);
                ctx.fillStyle = hp > 0.4 ? '#22c55e' : '#ef4444';
                ctx.fillRect(x - bw / 2, y + radius + 4, bw * hp, bh);
            }

            ctx.restore();
        }

        // 투사체 / 스킬 이펙트 / 화살표 그리기
        function drawArrow(x1, y1, x2, y2, color = '#fbbf24', dashed = false) {
            ctx.save();
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.lineWidth = 2.2;
            if (dashed) ctx.setLineDash([5, 4]);

            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();

            const angle = Math.atan2(y2 - y1, x2 - x1);
            const headLen = 8;
            ctx.setLineDash([]);
            ctx.beginPath();
            ctx.moveTo(x2, y2);
            ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI / 6), y2 - headLen * Math.sin(angle - Math.PI / 6));
            ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI / 6), y2 - headLen * Math.sin(angle + Math.PI / 6));
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }

        function drawWardVision(x, y, r, isPink) {
            ctx.save();
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fillStyle = isPink ? 'rgba(236, 72, 153, 0.14)' : 'rgba(250, 204, 21, 0.12)';
            ctx.fill();
            ctx.strokeStyle = isPink ? 'rgba(236, 72, 153, 0.65)' : 'rgba(250, 204, 21, 0.5)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 4]);
            ctx.stroke();

            // 와드 아이콘
            ctx.setLineDash([]);
            ctx.fillStyle = isPink ? '#ec4899' : '#facc15';
            ctx.beginPath();
            ctx.arc(x, y, 5, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        function drawBannerText(w, h, text, color = '#fbbf24') {
            ctx.save();
            ctx.fillStyle = 'rgba(1, 10, 19, 0.82)';
            ctx.roundRect(w * 0.5 - 150, h - 42, 300, 28, 8);
            ctx.fill();
            ctx.strokeStyle = color;
            ctx.lineWidth = 1.5;
            ctx.stroke();

            ctx.fillStyle = color;
            ctx.font = 'bold 12px "Noto Sans KR"';
            ctx.textAlign = 'center';
            ctx.fillText(text, w * 0.5, h - 24);
            ctx.restore();
        }

        // ==========================================
        // 4. 각 시나리오별 프레임 렌더러 (상황 vs 결과)
        // ==========================================
        function renderFrame(timestamp) {
            if (!animStartTime) animStartTime = timestamp;
            const elapsed = (timestamp - animStartTime) % LOOP_DURATION;
            const t = easeInOut(elapsed / LOOP_DURATION);

            const rect = wrapper.getBoundingClientRect();
            const w = rect.width;
            const h = rect.height;

            const qId = scenarios[currentIdx].id;

            if (qId === 1) renderScenario1(w, h, t);
            else if (qId === 2) renderScenario2(w, h, t);
            else if (qId === 3) renderScenario3(w, h, t);
            else if (qId === 4) renderScenario4(w, h, t);
            else if (qId === 5) renderScenario5(w, h, t);
            else if (qId === 6) renderScenario6(w, h, t);
            else if (qId === 7) renderScenario7(w, h, t);
            else if (qId === 8) renderScenario8(w, h, t);

            animFrameId = requestAnimationFrame(renderFrame);
        }

        // 상황 1: 바론 앞 돌진 조합 카이팅
        function renderScenario1(w, h, t) {
            drawMapTerrain(w, h, 'baron_front');

            if (animMode === 'scenario') {
                // 적 돌진 조합이 우상단에서 좌하단 아군 쪽으로 돌진
                const ex1 = lerp(w * 0.72, w * 0.50, t);
                const ey1 = lerp(h * 0.35, h * 0.52, t);
                const ex2 = lerp(w * 0.78, w * 0.56, t);
                const ey2 = lerp(h * 0.45, h * 0.58, t);

                drawArrow(w * 0.72, h * 0.35, w * 0.48, h * 0.53, '#f43f5e', true);
                drawUnit(ex1, ey1, '올라프', 'enemy');
                drawUnit(ex2, ey2, '레오나', 'enemy');
                drawUnit(w * 0.85, h * 0.32, '적 원딜', 'enemy');

                // 아군 서포터 & 나(원딜)
                drawUnit(w * 0.42, h * 0.60, '아군 서폿', 'ally');
                drawUnit(w * 0.32, h * 0.70, '나 (원딜)', 'player');
                drawBannerText(w, h, '적 돌진 조합이 정면으로 파고듭니다! 어떻게 대처할까요?', '#38bdf8');
            } else if (currentOutcomeType === 'kite_win') {
                // 정답(B): 뒤로 카이팅하며 앞라인 점사
                const px = lerp(w * 0.32, w * 0.16, t);
                const py = lerp(h * 0.70, h * 0.82, t);
                const sx = lerp(w * 0.42, w * 0.28, t);
                const sy = lerp(h * 0.60, h * 0.72, t);
                const ex = lerp(w * 0.52, w * 0.38, t);
                const ey = lerp(h * 0.52, h * 0.62, t);

                drawArrow(px, py, ex, ey, '#fbbf24', false);
                drawUnit(sx, sy, '아군 서폿', 'ally', { shield: true });
                drawUnit(px, py, '나 (원딜)', 'player', { shield: true });
                drawUnit(ex, ey, '올라프', 'enemy', { hp: Math.max(0.05, 1 - t * 0.95), dead: t > 0.85 });
                drawUnit(w * 0.82, h * 0.34, '적 원딜', 'enemy');
                drawBannerText(w, h, '성공! 서포터 보호 아래 카이팅으로 앞라인을 녹였습니다!', '#34d399');
            } else if (currentOutcomeType === 'dive_fail') {
                // 선택지 A: 레오나 쪽으로 일정 거리 걸어가다가 점멸(순간이동) 후 CC 연계에 폭사
                const startX = w * 0.32, startY = h * 0.70;
                const walkEndX = w * 0.43, walkEndY = h * 0.61;
                const flashEndX = w * 0.62, flashEndY = h * 0.47;

                let px, py, playerHp = 1.0, isDead = false;
                if (t < 0.35) {
                    // 1단계: 레오나 쪽으로 일정 거리 걸어감
                    const wt = t / 0.35;
                    px = lerp(startX, walkEndX, wt);
                    py = lerp(startY, walkEndY, wt);
                } else {
                    // 2단계: 점멸(순간이동) 발동!
                    px = flashEndX;
                    py = flashEndY;
                    const afterFlashT = (t - 0.35) / 0.65;
                    playerHp = Math.max(0, 1 - afterFlashT * 1.35);
                    isDead = afterFlashT > 0.72;
                }

                // 점멸 발동 순간 노란색 파티클 폭발 및 잔상 궤적 이펙트
                if (t >= 0.35 && t < 0.65) {
                    const flashAnim = (t - 0.35) / 0.30;
                    ctx.save();
                    // 점멸 출발지 잔상 링
                    ctx.strokeStyle = `rgba(250, 204, 21, ${1 - flashAnim})`;
                    ctx.lineWidth = 2.5;
                    ctx.beginPath();
                    ctx.arc(walkEndX, walkEndY, 12 + flashAnim * 18, 0, Math.PI * 2);
                    ctx.stroke();

                    // 점멸 이동 경로 빛줄기
                    ctx.strokeStyle = `rgba(253, 224, 71, ${0.85 * (1 - flashAnim)})`;
                    ctx.lineWidth = 3;
                    ctx.setLineDash([4, 3]);
                    ctx.beginPath();
                    ctx.moveTo(walkEndX, walkEndY);
                    ctx.lineTo(flashEndX, flashEndY);
                    ctx.stroke();
                    ctx.setLineDash([]);

                    // 도착지 점멸 섬광 폭발
                    ctx.fillStyle = `rgba(254, 240, 138, ${0.7 * (1 - flashAnim)})`;
                    ctx.beginPath();
                    ctx.arc(flashEndX, flashEndY, 16 + flashAnim * 26, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }

                // 점멸 후 레오나/올라프에게 둘러싸여 포커싱당함
                const leoX = lerp(w * 0.72, w * 0.66, t);
                const leoY = lerp(h * 0.44, h * 0.46, t);
                const olafX = lerp(w * 0.64, w * 0.58, t);
                const olafY = lerp(h * 0.35, h * 0.42, t);

                drawUnit(w * 0.40, h * 0.64, '아군 서폿', 'ally');
                drawUnit(olafX, olafY, '올라프', 'enemy');
                drawUnit(leoX, leoY, '레오나', 'enemy');
                drawUnit(w * 0.83, h * 0.34, '적 원딜', 'enemy');
                drawUnit(px, py, t >= 0.35 && t < 0.55 ? '나 (점멸!)' : '나 (원딜)', 'player', { hp: playerHp, dead: isDead });

                drawBannerText(w, h, '실패! 레오나 쪽으로 앞점멸을 써서 적진 한복판에서 폭사했습니다!', '#fb7185');
            } else if (currentOutcomeType === 'hide_fail') {
                // 선택지 C: 바론 둥지 근처에서 좌우로 조금씩 움직이는 동안 적들이 아군 서폿을 잡고 몰려옴
                const swayX = w * 0.34 + Math.sin(t * Math.PI * 6) * 14;
                const swayY = h * 0.24;

                const suppX = w * 0.45, suppY = h * 0.60;
                const suppHp = Math.max(0, 1 - (t / 0.45));
                const suppDead = t >= 0.45;

                // 전반부(t < 0.45): 적들이 아군 서폿을 포위해 처치 -> 후반부(t >= 0.45): 바론 둥지 쪽 나의 위치로 몰려옴
                let olafX, olafY, leoX, leoY, adcX, adcY;
                if (t < 0.45) {
                    const p1 = t / 0.45;
                    olafX = lerp(w * 0.66, suppX + 20, p1);
                    olafY = lerp(h * 0.38, suppY - 12, p1);
                    leoX = lerp(w * 0.72, suppX + 24, p1);
                    leoY = lerp(h * 0.48, suppY + 10, p1);
                    adcX = lerp(w * 0.82, suppX + 46, p1);
                    adcY = lerp(h * 0.34, suppY, p1);
                } else {
                    const p2 = (t - 0.45) / 0.55;
                    olafX = lerp(suppX + 20, swayX + 18, p2);
                    olafY = lerp(suppY - 12, swayY + 14, p2);
                    leoX = lerp(suppX + 24, swayX + 24, p2);
                    leoY = lerp(suppY + 10, swayY + 20, p2);
                    adcX = lerp(suppX + 46, swayX + 42, p2);
                    adcY = lerp(suppY, swayY + 12, p2);
                    drawArrow(suppX + 20, suppY - 12, swayX + 12, swayY + 10, '#f43f5e', true);
                }

                const playerHp = t > 0.72 ? Math.max(0, 1 - ((t - 0.72) / 0.28) * 1.1) : 1.0;
                const playerDead = t > 0.92;

                drawUnit(suppX, suppY, '아군 서폿', 'ally', { hp: suppHp, dead: suppDead });
                drawUnit(swayX, swayY, '나 (눈치 보는 중)', 'player', { hp: playerHp, dead: playerDead });
                drawUnit(olafX, olafY, '올라프', 'enemy');
                drawUnit(leoX, leoY, '레오나', 'enemy');
                drawUnit(adcX, adcY, '적 원딜', 'enemy');

                drawBannerText(w, h, '실패! 딜 공백 사이 아군 서폿이 먼저 잡히고 적군이 몰려옵니다!', '#fb7185');
            } else {
                // 선택지 D: 바론 둥지 안으로 들어가 바론을 치다가 바론의 산성 공격에 데미지를 입고 사망
                const baronX = w * 0.50, baronY = h * 0.16;
                const px = t < 0.25 ? lerp(w * 0.32, w * 0.46, t / 0.25) : w * 0.46;
                const py = t < 0.25 ? lerp(h * 0.70, h * 0.26, t / 0.25) : h * 0.26;

                let playerHp = 1.0;
                let isDead = false;

                if (t >= 0.25) {
                    const fightT = (t - 0.25) / 0.75;
                    playerHp = Math.max(0, 1 - fightT * 1.18);
                    isDead = fightT > 0.82;

                    // 플레이어가 바론을 공격하는 화살표
                    if (!isDead) {
                        drawArrow(px, py, baronX, baronY + 8, '#fbbf24', false);
                    }

                    // 바론의 보라색 산성 투사체 & 피격 파동 이펙트 (3연속 타격 연출)
                    const pulse = (fightT * 3) % 1;
                    const projX = lerp(baronX, px, pulse);
                    const projY = lerp(baronY, py, pulse);

                    ctx.save();
                    // 보라색 산성 투사체
                    ctx.fillStyle = '#c084fc';
                    ctx.shadowColor = '#a855f7';
                    ctx.shadowBlur = 10;
                    ctx.beginPath();
                    ctx.arc(projX, projY, 6, 0, Math.PI * 2);
                    ctx.fill();

                    // 피격 시 바론 광역 데미지 링 및 데미지 텍스트
                    if (pulse > 0.72 && !isDead) {
                        ctx.strokeStyle = '#e879f9';
                        ctx.lineWidth = 2.5;
                        ctx.beginPath();
                        ctx.arc(px, py, 16 + (pulse - 0.72) * 45, 0, Math.PI * 2);
                        ctx.stroke();

                        ctx.fillStyle = '#f0abfc';
                        ctx.font = 'bold 12px "Noto Sans KR"';
                        ctx.textAlign = 'center';
                        ctx.fillText('-480 (바론 피해!)', px, py - 24 - (pulse - 0.72) * 20);
                    }
                    ctx.restore();
                }

                drawUnit(w * 0.42, h * 0.62, '아군 서폿', 'ally');
                drawUnit(w * 0.66, h * 0.44, '올라프', 'enemy');
                drawUnit(w * 0.74, h * 0.50, '레오나', 'enemy');
                drawUnit(px, py, isDead ? '나 (바론에 처형)' : '나 (원딜)', 'player', { hp: playerHp, dead: isDead });

                drawBannerText(w, h, '실패! 바론의 강력한 광역 산성 피해를 버티지 못하고 처형당했습니다!', '#fb7185');
            }
        }

        // 상황 2: 이블린 은신 & 제어 와드
        function renderScenario2(w, h, t) {
            drawMapTerrain(w, h, 'jungle_ward');

            if (animMode === 'scenario') {
                // 일반 투명 와드만 박혀 있음 -> 이블린이 위장 상태로 접근
                drawWardVision(w * 0.45, h * 0.35, 55, false);
                const ix = lerp(w * 0.22, w * 0.58, t);
                const iy = lerp(h * 0.75, h * 0.42, t);
                drawUnit(ix, iy, '이블린 (은신)', 'enemy', { stealth: true });
                drawUnit(w * 0.68, h * 0.32, '나 (라이너)', 'player');
                drawUnit(w * 0.20, h * 0.25, '아군 본대', 'ally');
                drawBannerText(w, h, '일반 와드는 이블린의 은신을 감지하지 못합니다!', '#38bdf8');
            } else if (currentOutcomeType === 'ward_detect') {
                // 정답: 제어 와드 설치 & 아군 쪽으로 합류
                drawWardVision(w * 0.45, h * 0.48, 75, true);
                const ix = lerp(w * 0.25, w * 0.42, t);
                const iy = lerp(h * 0.72, h * 0.54, t);
                const px = lerp(w * 0.68, w * 0.32, t);
                const py = lerp(h * 0.32, h * 0.26, t);

                // 감지 범위 진입 시 은신 해제
                const detected = t > 0.45;
                drawUnit(ix, iy, detected ? '이블린 (발각!)' : '이블린', 'enemy', { stealth: !detected });
                drawUnit(px, py, '나 (합류)', 'player');
                drawUnit(w * 0.22, h * 0.25, '아군 본대', 'ally');
                drawBannerText(w, h, '성공! 제어 와드로 이블린을 감지하고 안전하게 합류했습니다!', '#34d399');
            } else {
                // 오답: 은신 암살당함
                const ix = lerp(w * 0.35, w * 0.66, t);
                const iy = lerp(h * 0.60, h * 0.34, t);
                drawUnit(ix, iy, '이블린', 'enemy', { stealth: t < 0.6 });
