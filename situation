        function startAnimationLoop(mode = 'scenario', outcomeType = null) {
            animMode = mode;
            currentOutcomeType = outcomeType;
            animStartTime = 0;

            const statusText = document.getElementById('sim-status-text');
            const statusPill = document.getElementById('sim-status-pill');

            if (mode === 'scenario') {
                statusText.textContent = '전장 상황 재생 중 (루프)';
                statusPill.className = 'px-3 py-1 rounded-full bg-hextech-dark/90 border border-hextech-blue/60 text-hextech-blue text-xs font-bold flex items-center gap-1.5 shadow';
            } else {
                statusText.textContent = '선택 결과 시뮬레이션 재생 중';
                statusPill.className = 'px-3 py-1 rounded-full bg-hextech-dark/90 border border-hextech-gold/80 text-hextech-gold text-xs font-bold flex items-center gap-1.5 shadow';
            }

            if (animFrameId) cancelAnimationFrame(animFrameId);
            resizeCanvas();
            animFrameId = requestAnimationFrame(renderFrame);
        }

        function replayAnimation() {
            playSfx('replay');
            startAnimationLoop('scenario', null);
        }

        function replayOutcome() {
            if (!currentOutcomeType) return;
            playSfx('replay');
            startAnimationLoop('outcome', currentOutcomeType);
        }

        // ==========================================
        // 5. 퀴즈 진행 및 결과 판정 로직
        // ==========================================
        let currentIdx = 0;
        let totalScore = 0;
        let correctCount = 0;
        let hasAnswered = false;
        let missedNotes = [];
        let currentShuffledOptions = []; // 현재 문제의 셔플된 선택지 목록 저장

        // Fisher-Yates 셔플 유틸리티
        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        const startScreen = document.getElementById('start-screen');
        const quizScreen = document.getElementById('quiz-screen');
        const resultScreen = document.getElementById('result-screen');

        function startSimulator() {
            currentIdx = 0;
            totalScore = 0;
            correctCount = 0;
            missedNotes = [];
            startScreen.classList.add('hidden');
            resultScreen.classList.add('hidden');
            quizScreen.classList.remove('hidden');
            renderScenario();
        }

        function renderScenario() {
            hasAnswered = false;
            const item = scenarios[currentIdx];

            document.getElementById('question-counter').textContent = `상황 ${currentIdx + 1} / ${scenarios.length}`;
            document.getElementById('category-badge').textContent = item.category;
            document.getElementById('score-counter').textContent = `현재 점수: ${Math.round(totalScore)}점`;
            document.getElementById('progress-bar').style.width = `${((currentIdx + 1) / scenarios.length) * 100}%`;
            document.getElementById('role-tag').textContent = `포지션: ${item.role}`;
            document.getElementById('scenario-desc').textContent = item.desc;
            document.getElementById('question-prompt').textContent = item.question;

            const feedbackBox = document.getElementById('feedback-box');
            feedbackBox.classList.add('hidden');

            const optionsList = document.getElementById('options-list');
            optionsList.innerHTML = '';

            // 원본 선택지에 고유 originalId('A','B','C','D') 부여 후 매번 랜덤하게 셔플
            const indexedOptions = item.options.map((opt, idx) => ({
                ...opt,
                originalId: String.fromCharCode(65 + idx)
            }));
            currentShuffledOptions = shuffleArray(indexedOptions);

            currentShuffledOptions.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = "w-full text-left p-3.5 sm:p-4 rounded-xl bg-hextech-dark border border-slate-700 hover:border-hextech-gold hover:bg-slate-900 transition-all duration-150 flex items-start gap-3 group";
                btn.innerHTML = `
                    <span class="shrink-0 w-7 h-7 rounded-lg bg-slate-800 border border-slate-600 group-hover:border-hextech-gold group-hover:text-hextech-gold flex items-center justify-center text-xs font-black text-slate-300 transition">
                        ${String.fromCharCode(65 + idx)}
                    </span>
                    <span class="text-xs sm:text-sm text-slate-200 leading-snug pt-1">${opt.text}</span>
                `;
                btn.onclick = () => selectOption(idx);
                optionsList.appendChild(btn);
            });

            document.getElementById('next-btn').textContent =
                currentIdx === scenarios.length - 1 ? "최종 티어 결과 확인 →" : "다음 상황으로 →";

            // 상황 애니메이션 시작
            startAnimationLoop('scenario', null);
        }

        function selectOption(selectedIdx) {
            if (hasAnswered) return;
            hasAnswered = true;

            const item = scenarios[currentIdx];
            const chosen = currentShuffledOptions[selectedIdx];
            const buttons = document.getElementById('options-list').querySelectorAll('button');

            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                btn.classList.remove('hover:border-hextech-gold', 'hover:bg-slate-900');
                const opt = currentShuffledOptions[idx];

                if (opt.isCorrect) {
                    btn.classList.remove('bg-hextech-dark', 'border-slate-700');
                    btn.classList.add('bg-emerald-950/75', 'border-emerald-500', 'ring-1', 'ring-emerald-500/50');
                    btn.querySelector('span:first-child').classList.add('bg-emerald-600', 'text-white', 'border-emerald-400');
                } else if (idx === selectedIdx && !opt.isCorrect) {
                    btn.classList.remove('bg-hextech-dark', 'border-slate-700');
                    btn.classList.add('bg-rose-950/75', 'border-rose-500', 'ring-1', 'ring-rose-500/50');
                    btn.querySelector('span:first-child').classList.add('bg-rose-600', 'text-white', 'border-rose-400');
                } else {
                    btn.classList.add('opacity-50');
                }
            });

            const feedbackBox = document.getElementById('feedback-box');
            const feedbackIcon = document.getElementById('feedback-icon');
            const feedbackHeading = document.getElementById('feedback-heading');
            const feedbackExplanation = document.getElementById('feedback-explanation');

            const pointsPerQuestion = 100 / scenarios.length;

            if (chosen.isCorrect) {
                totalScore += pointsPerQuestion;
                correctCount++;
                playSfx('correct');
                feedbackBox.className = "rounded-xl p-4 sm:p-5 border border-emerald-500/60 bg-emerald-950/40 transition-all duration-200 space-y-3";
                feedbackIcon.textContent = "🏆";
                feedbackHeading.textContent = "전술 판단 성공! 최선의 플레이입니다.";
                feedbackHeading.className = "font-black text-base sm:text-lg text-emerald-400";
            } else {
                playSfx('wrong');
                const rightOpt = item.options.find(o => o.isCorrect);
                missedNotes.push({
                    category: item.category,
                    tip: rightOpt ? rightOpt.rationale : chosen.rationale
                });
                feedbackBox.className = "rounded-xl p-4 sm:p-5 border border-rose-500/60 bg-rose-950/40 transition-all duration-200 space-y-3";
                feedbackIcon.textContent = "💀";
                feedbackHeading.textContent = "전술 판단 실패! 위험한 선택입니다.";
                feedbackHeading.className = "font-black text-base sm:text-lg text-rose-400";
            }

            document.getElementById('score-counter').textContent = `현재 점수: ${Math.round(totalScore)}점`;
            feedbackExplanation.textContent = chosen.rationale;
            feedbackBox.classList.remove('hidden');

            // 선택한 결과 애니메이션 재생
            startAnimationLoop('outcome', chosen.outcomeType);
        }

        function handleNextQuestion() {
            currentIdx++;
            if (currentIdx < scenarios.length) {
                renderScenario();
            } else {
                showResults();
            }
        }

        function showResults() {
            if (animFrameId) cancelAnimationFrame(animFrameId);
            quizScreen.classList.add('hidden');
            resultScreen.classList.remove('hidden');

            const finalPoints = Math.round(totalScore);
            document.getElementById('final-score-text').textContent = `${finalPoints} / 100점`;
            document.getElementById('correct-count-text').textContent = `총 ${scenarios.length}문제 중 ${correctCount}문제 정답`;

            const tierBadge = document.getElementById('tier-badge');
            const tierFeedback = document.getElementById('tier-feedback-text');

            if (finalPoints >= 95) {
                tierBadge.textContent = "CHALLENGER • 챌린저";
                tierBadge.className = "inline-block px-4 py-1.5 rounded-full text-sm font-black tracking-wider uppercase border border-amber-400 bg-amber-500/20 text-amber-300";
                tierFeedback.textContent = "완벽한 협곡 뇌지컬입니다! 교전 포지셔닝, 시야 장악, 스플릿 운영까지 모든 판단이 프로 수준에 가깝습니다.";
            } else if (finalPoints >= 75) {
                tierBadge.textContent = "DIAMOND • 다이아몬드";
                tierBadge.className = "inline-block px-4 py-1.5 rounded-full text-sm font-black tracking-wider uppercase border border-sky-400 bg-sky-500/20 text-sky-300";
                tierFeedback.textContent = "상위권 판단력을 갖추셨습니다! 대부분의 한타 구도와 운영 타이밍을 정확히 읽고 계시며, 세부적인 변수만 보완하면 마스터 이상도 충분합니다.";
            } else if (finalPoints >= 50) {
                tierBadge.textContent = "GOLD / PLATINUM • 골드~플래티넘";
                tierBadge.className = "inline-block px-4 py-1.5 rounded-full text-sm font-black tracking-wider uppercase border border-emerald-400 bg-emerald-500/20 text-emerald-300";
                tierFeedback.textContent = "기본적인 교전 감각은 좋지만, 유리할 때의 귀환 정비나 시야 없는 단독 행동에서 종종 역전을 허용할 수 있습니다.";
            } else {
                tierBadge.textContent = "IRON / BRONZE • 아이언~브론즈";
                tierBadge.className = "inline-block px-4 py-1.5 rounded-full text-sm font-black tracking-wider uppercase border border-rose-400 bg-rose-500/20 text-rose-300";
                tierFeedback.textContent = "무작정 싸움을 걸기보다 미니맵 시야 확보와 진형 유지 연습이 필요합니다. 아래 오답 노트의 핵심 포인트를 다시 확인해 보세요!";
            }

            const reviewContainer = document.getElementById('review-summary-container');
            const missedList = document.getElementById('missed-list');
            missedList.innerHTML = '';

            if (missedNotes.length > 0) {
                reviewContainer.classList.remove('hidden');
                missedNotes.forEach(note => {
                    const li = document.createElement('li');
                    li.className = "p-2.5 rounded-lg bg-slate-900/90 border border-slate-800";
                    li.innerHTML = `<strong class="text-hextech-gold">[${note.category}]</strong> ${note.tip}`;
                    missedList.appendChild(li);
                });
            } else {
                reviewContainer.classList.add('hidden');
            }
        }

        function restartSimulator() {
            resultScreen.classList.add('hidden');
            startScreen.classList.remove('hidden');
        }
    </script>
</body>
</html>
